;; Two dependencies, and neither is a Filecoin SDK.
;;
;;   io-filecoin       — addresses (an `f410f…` and an `0x…` are the same
;;                       actor), the Lotus RPC surface, and decimal-string
;;                       amounts. Onchain Cloud is FEVM contracts about
;;                       Filecoin data, so a client needs both halves.
;;   org-ethereum-abi  — head/tail argument encoding, including the arrays
;;                       and tuples these contracts take. Split out rather
;;                       than written here, because nothing about the ABI is
;;                       Filecoin's.
;;
;; io-multiformats arrives through io-filecoin and is used directly for
;; SHA-256, base32 and varint; it is declared so that is visible.
;;
;; No keccak: selectors are constants checked against the deployed ABI. No
;; signing, no transport, no socket.
{:paths ["src"]
 :deps {io.github.kotoba-lang/io-filecoin
        {:git/sha "b28b628c4c5ffa3594ce8242eefd286352a464b7"}
        io.github.kotoba-lang/org-ethereum-abi
        {:git/sha "f3e5662d86977b50224e5e890f953cb5e4b3f441"}
        io.github.kotoba-lang/io-multiformats
        {:git/sha "561fe7dfada3db852b127f06d41750dabd3cead9"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; classpath only, no :main-opts — `clojure -A:cljs -Spath` resolves the git
  ;; deps for nbb without the deprecation warning `-A` prints when the alias
  ;; carries a main.
  :cljs {:extra-paths ["test"]}

  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
